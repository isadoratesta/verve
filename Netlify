    /* O restante do body preserva a estrutura anterior */
    #jornada{
      position:relative;
    }


    /* =========================================================
       UX/UI SYSTEM — CORES + TIPOGRAFIA COMO REFERÊNCIA
       ========================================================= */
    :root{
      --ux-navy:#0B1430;
      --ux-navy-2:#142044;
      --ux-lilac:#B98BD6;
      --ux-lilac-soft:#D6B5E8;
      --ux-rose:#E9C8DF;
      --ux-paper:#F5EEF5;
      --ux-paper-2:#E8DCEB;
      --ux-white:#FFFBFE;
      --ux-ink:#14182B;
      --ux-muted:#555A6D;
      --ux-border:rgba(20,24,43,.13);
      --ux-shadow:0 20px 55px rgba(11,20,48,.11);
      --ux-radius:24px;
      --section-space:clamp(72px,9vw,120px);
    }

    body{
      font-family:'Manrope',sans-serif;
      background:var(--ux-paper);
      color:var(--ux-ink);
      line-height:1.65;
    }
    h1,h2,h3{
      font-family:'Bodoni Moda',serif;
      text-wrap:balance;
    }
    p{max-width:70ch}
    section{padding-block:var(--section-space)}
    .container{width:min(1180px,calc(100% - 40px))}

    .site-header{
      position:sticky;
      top:0;
      background:rgba(11,20,48,.94);
      border-bottom:1px solid rgba(255,255,255,.12);
      backdrop-filter:blur(14px);
    }
    .nav{min-height:74px}
    .site-header .logo,
    .site-header .nav-links a{color:var(--ux-white)}
    .site-header .nav-cta{
      background:var(--ux-lilac-soft);
      color:var(--ux-ink)!important;
      border:0;
    }

    /* HERO: composição própria, sem reproduzir o template da referência */
    .hero{
      min-height:auto;
      padding:clamp(85px,10vw,132px) 0 clamp(74px,9vw,116px);
      background:
        radial-gradient(circle at 90% 15%,rgba(185,139,214,.22),transparent 28%),
        radial-gradient(circle at 8% 5%,rgba(233,200,223,.13),transparent 24%),
        var(--ux-navy);
      color:var(--ux-white);
    }
    .hero::before,.hero::after{display:none}
    .hero-grid{
      grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);
      gap:clamp(48px,7vw,92px);
    }
    .hero h1{
      font-size:clamp(54px,6.5vw,92px);
      line-height:.98;
      max-width:800px;
    }
    .hero-lead{
      font-size:clamp(22px,2vw,29px);
      line-height:1.35;
      max-width:680px;
    }
    .hero-copy{font-size:17px;max-width:650px}
    .hero-script{display:none}

    .hero .actions{margin-top:32px}
    .hero .btn-primary{
      background:var(--ux-lilac-soft);
      color:var(--ux-ink);
    }
    .hero .btn-secondary{
      color:var(--ux-white);
      border-color:rgba(255,255,255,.24);
    }

    /* imagem/diagrama do hero com função informativa */
    .journey-panel{
      min-height:490px;
      padding:28px;
      border-radius:32px;
      justify-content:flex-start;
      background:
        linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.035)),
        var(--ux-navy-2);
      border:1px solid rgba(255,255,255,.14);
      box-shadow:0 28px 80px rgba(0,0,0,.24);
    }
    .journey-panel::before,.journey-panel::after{display:none}
    .journey-panel .panel-kicker,
    .journey-panel h2{
      position:static;
      transform:none;
      text-align:left;
    }
    .journey-panel .panel-kicker{color:var(--ux-lilac-soft)}
    .journey-panel h2{
      font-size:42px;
      margin:14px 0 24px;
    }
    .journey-track{
      padding:0;
      margin:0;
      grid-template-columns:1fr;
      background:transparent;
      border:0;
      backdrop-filter:none;
      gap:12px;
    }
    .journey-step{
      min-height:auto;
      display:grid;
      grid-template-columns:18px 1fr;
      column-gap:12px;
      padding:16px;
      border-radius:16px;
      background:rgba(255,255,255,.06);
    }
    .journey-step::before{
      grid-row:1 / span 2;
      align-self:start;
      margin-top:5px;
    }
    .journey-step strong,.journey-step span{grid-column:2}
    .journey-step span{color:rgba(255,255,255,.66)}

    .signal-strip{
      background:var(--ux-paper-2);
      border-color:var(--ux-border);
    }
    .signal i{background:var(--ux-lilac)}

    /* títulos e introduções */
    .section-head{
      display:grid;
      grid-template-columns:minmax(0,.88fr) minmax(300px,.6fr);
      align-items:end;
      gap:48px;
      max-width:none;
      margin-bottom:52px;
    }
    .section-head h2{
      font-size:clamp(42px,5vw,68px);
      line-height:1.02;
      margin-bottom:0;
    }
    .section-head p{
      margin:0;
      color:var(--ux-muted);
      font-size:17px;
    }
    .section-kicker{color:#79598A}

    /* seção de jornada: conteúdo + visual com boa escaneabilidade */
    .journey-map{
      padding:32px;
      border-radius:var(--ux-radius);
      box-shadow:none;
      background:var(--ux-white);
      border-color:var(--ux-border);
    }
    .map-grid{
      grid-template-columns:repeat(3,1fr);
      margin-top:0;
      gap:16px;
    }
    .map-line{display:none}
    .map-item{
      text-align:left;
      padding:22px;
      border-radius:18px;
      background:var(--ux-paper);
      border:1px solid var(--ux-border);
    }
    .map-dot{
      width:12px;height:12px;
      margin:0 0 18px;
      border:0;
      box-shadow:none;
    }
    .map-item h3{
      font-family:'Manrope',sans-serif;
      font-size:16px;
    }
    .map-item p{font-size:14px}

    /* tese: texto de um lado, visual explicativo do outro */
    .thesis{
      background:var(--ux-navy);
    }
    .split{
      grid-template-columns:minmax(0,1fr) minmax(360px,.75fr);
      gap:clamp(48px,7vw,84px);
      align-items:center;
    }
    .thesis-card{
      position:relative;
      top:auto;
      min-height:430px;
      display:flex;
      flex-direction:column;
      justify-content:flex-end;
      overflow:hidden;
      background:
        radial-gradient(circle at 50% 34%,rgba(233,200,223,.42),transparent 21%),
        repeating-radial-gradient(circle at 50% 34%,rgba(255,255,255,.10) 0 1px,transparent 1px 32px),
        linear-gradient(150deg,#76548D,#17234A 70%);
    }
    .thesis-card::before{
      content:"";
      position:absolute;
      left:50%;top:35%;
      width:18px;height:18px;
      border-radius:50%;
      transform:translate(-50%,-50%);
      background:var(--ux-rose);
      box-shadow:0 0 0 18px rgba(233,200,223,.1);
    }
    .thesis-card blockquote{
      position:relative;
      padding:24px;
      border-radius:18px;
      background:rgba(11,20,48,.65);
      backdrop-filter:blur(14px);
      font-size:26px;
    }

    /* problemas: melhor densidade, sem oito cartões iguais */
    .problem-grid{
      grid-template-columns:repeat(4,1fr);
      gap:14px;
    }
    .problem{
      min-height:190px;
      padding:22px;
      background:var(--ux-white);
      border-color:var(--ux-border);
      box-shadow:none;
    }
    .problem:hover{box-shadow:var(--ux-shadow)}
    .problem span{
      background:var(--ux-paper-2);
      color:#735383;
    }

    /* resultados com alternância visual */
    .outcomes{background:var(--ux-paper-2)}
    .outcome-grid{gap:16px}
    .outcome{
      border-color:var(--ux-border);
      border-radius:var(--ux-radius);
    }
    .outcome:nth-child(2){
      background:var(--ux-navy);
    }
    .outcome .num{color:#825E91}

    /* produtos: foco em comparação e decisão */
    .products{background:var(--ux-navy)}
    .product-grid{align-items:stretch}
    .product{
      min-height:500px;
      border-radius:var(--ux-radius);
      background:var(--ux-navy-2);
    }
    .product.featured{
      background:var(--ux-paper);
    }
    .price{color:var(--ux-lilac-soft)}

    /* prova: visual no máximo 40%, texto mais legível */
    .proof-card{
      grid-template-columns:minmax(280px,.65fr) minmax(0,1.35fr);
      gap:52px;
      border-radius:var(--ux-radius);
      border-color:var(--ux-border);
      box-shadow:none;
    }
    .proof-mark{
      min-height:320px;
      background:
        radial-gradient(circle at 50% 50%,rgba(233,200,223,.75),transparent 22%),
        repeating-radial-gradient(circle at 50% 50%,rgba(11,20,48,.10) 0 1px,transparent 1px 30px),
        var(--ux-paper-2);
    }
    .proof-copy h2{
      font-size:clamp(40px,4vw,58px);
    }

    .final-cta{
      background:var(--ux-paper-2);
    }
    .final-cta h2{
      font-size:clamp(44px,5.5vw,72px);
      max-width:820px;
    }

    footer{background:var(--ux-navy)}


    /* =========================================================
       WIREFRAME SEM IMAGENS
       Estrutura pensada para alta densidade de informação
       ========================================================= */
    :root{
      --wf-navy:#0B1430;
      --wf-navy-2:#152144;
      --wf-lilac:#B98BD6;
      --wf-lilac-soft:#D6B5E8;
      --wf-rose:#E9C8DF;
      --wf-bg:#F5EEF5;
      --wf-bg-2:#E9DDEB;
      --wf-card:#FFFBFE;
      --wf-ink:#15192D;
      --wf-muted:#5C6174;
      --wf-border:rgba(21,25,45,.13);
      --wf-shadow:0 16px 46px rgba(11,20,48,.08);
      --wf-radius:20px;
      --wf-space:clamp(70px,8vw,108px);
    }

    body{
      background:var(--wf-bg);
      color:var(--wf-ink);
    }
    section{padding-block:var(--wf-space)}
    .container{width:min(1120px,calc(100% - 40px))}
    .section-head{
      display:block;
      max-width:820px;
      margin-bottom:42px;
    }
    .section-head h2{
      max-width:760px;
      font-size:clamp(40px,4.8vw,64px);
      line-height:1.02;
      margin-bottom:16px;
    }
    .section-head p{
      max-width:720px;
      margin:0;
      font-size:17px;
      color:var(--wf-muted);
    }

    /* header */
    .site-header{
      background:var(--wf-navy);
      border-bottom:1px solid rgba(255,255,255,.12);
    }

    /* hero */
    .hero{
      min-height:auto;
      padding:110px 0 88px;
      background:var(--wf-navy);
    }
    .hero-grid{
      grid-template-columns:minmax(0,1.15fr) minmax(330px,.85fr);
      gap:56px;
      align-items:start;
    }
    .hero h1{
      font-size:clamp(54px,6vw,84px);
      line-height:.97;
      max-width:760px;
      margin-bottom:24px;
    }
    .hero-lead{
      max-width:700px;
      font-size:clamp(22px,2vw,29px);
      line-height:1.35;
    }
    .hero-copy{
      max-width:680px;
      font-size:17px;
    }
    .journey-panel{
      min-height:auto;
      padding:24px;
      border-radius:var(--wf-radius);
      background:var(--wf-navy-2);
      border:1px solid rgba(255,255,255,.14);
      box-shadow:none;
    }
    .journey-panel h2{
      font-size:38px;
      margin-bottom:18px;
    }
    .journey-track{
      gap:10px;
    }
    .journey-step{
      border-radius:14px;
      background:rgba(255,255,255,.055);
      min-height:auto;
    }

    /* strip */
    .signal-strip{
      padding:16px 0;
      background:var(--wf-bg-2);
    }
    .signal-grid{
      grid-template-columns:repeat(5,1fr);
      gap:10px;
    }
    .signal{
      justify-content:center;
      text-align:center;
      min-height:48px;
      padding:8px 10px;
      border:1px solid var(--wf-border);
      border-radius:12px;
      background:rgba(255,255,255,.42);
      font-size:12px;
    }

    /* journey */
    .journey-map{
      padding:0;
      background:transparent;
      border:0;
      box-shadow:none;
    }
    .map-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:14px;
    }
    .map-item{
      min-height:190px;
      padding:22px;
      border:1px solid var(--wf-border);
      border-radius:var(--wf-radius);
      background:var(--wf-card);
    }
    .map-item h3{
      font-family:'Manrope',sans-serif;
      font-size:16px;
      margin-bottom:10px;
    }
    .map-item p{font-size:14px}
    .map-dot{
      width:10px;height:10px;
      margin-bottom:20px;
    }

    /* thesis */
    .thesis{background:var(--wf-navy)}
    .split{
      grid-template-columns:1.1fr .9fr;
      gap:52px;
      align-items:start;
    }
    .thesis-card{
      min-height:auto;
      position:sticky;
      top:110px;
      padding:28px;
      background:var(--wf-navy-2);
      border-radius:var(--wf-radius);
      border:1px solid rgba(255,255,255,.14);
    }
    .thesis-card::before{display:none}
    .thesis-card blockquote{
      padding:0;
      margin:0;
      background:transparent;
      backdrop-filter:none;
      font-size:28px;
      line-height:1.35;
    }

    /* problems */
    .problem-grid{
      grid-template-columns:repeat(2,1fr);
      gap:14px;
    }
    .problem{
      display:grid;
      grid-template-columns:40px 1fr;
      column-gap:16px;
      align-items:start;
      min-height:auto;
      padding:20px;
      border-radius:16px;
      box-shadow:none;
    }
    .problem span{
      margin:0;
      grid-row:1 / span 2;
    }
    .problem h3,
    .problem p{
      grid-column:2;
    }
    .problem h3{
      font-family:'Manrope',sans-serif;
      font-size:16px;
      margin:0 0 6px;
    }
    .problem p{
      margin:0;
      font-size:14px;
    }

    /* outcomes */
    .outcomes{background:var(--wf-bg-2)}
    .outcome-grid{
      grid-template-columns:repeat(3,1fr);
      gap:14px;
    }
    .outcome{
      min-height:280px;
      padding:26px;
      border-radius:var(--wf-radius);
      box-shadow:none;
    }
    .outcome .num{margin-bottom:28px}
    .outcome h3{font-size:30px}

    /* products */
    .products{background:var(--wf-navy)}
    .product-grid{
      grid-template-columns:1fr 1fr;
      gap:16px;
    }
    .product{
      min-height:auto;
      padding:28px;
      border-radius:var(--wf-radius);
    }
    .product h3{
      font-size:38px;
      margin:18px 0;
    }
    .product-list{
      margin-top:16px;
    }

    /* proof */
    .proof-card{
      display:block;
      padding:34px;
      border-radius:var(--wf-radius);
      box-shadow:none;
    }
    .proof-mark{display:none}
    .proof-copy{
      display:grid;
      grid-template-columns:.75fr 1.25fr;
      gap:42px;
      align-items:start;
    }
    .proof-copy .section-kicker{
      grid-column:1;
    }
    .proof-copy h2{
      grid-column:1;
      font-size:clamp(38px,4vw,54px);
      margin-bottom:0;
    }
    .proof-copy p{
      grid-column:2;
      margin-bottom:14px;
      font-size:17px;
    }

    /* cta */
    .final-cta{
      padding:88px 0;
      background:var(--wf-bg-2);
    }
    .final-cta h2{
      max-width:760px;
      font-size:clamp(42px,5vw,66px);
    }

    /* remove all decorative image-like visuals */
    .hero::before,
    .hero::after,
    .journey-panel::before,
    .journey-panel::after,
    .thesis-card::before,
    .proof-mark::before,
    .proof-mark::after{
      display:none!important;
    }

    @media(max-width:980px){
      .hero-grid,.split,.proof-copy{grid-template-columns:1fr}
      .thesis-card{position:static}
      .signal-grid{grid-template-columns:repeat(2,1fr)}
      .map-grid{grid-template-columns:repeat(2,1fr)}
      .outcome-grid{grid-template-columns:1fr}
