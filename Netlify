  <style>
    :root{
      --ink:#171B20;
      --ink-2:#2B3138;
      --paper:#F4EFE5;
      --paper-2:#E9E0CF;
      --white:#FFFDF8;
      --copper:#C9862D;
      --sage:#6C7A67;
      --terracotta:#9A4E3D;
      --line:#D6CCBA;
      --mist:#DCE4DE;
      --shadow:0 18px 50px rgba(23,27,32,.10);
      --radius:22px;
      --container:min(1180px, calc(100% - 40px));
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      color:var(--ink);
      background:var(--paper);
      font-family:'Manrope',sans-serif;
      font-size:16px;
      line-height:1.6;
      -webkit-font-smoothing:antialiased;
      overflow-x:hidden;
    }
    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      opacity:.18;
      background-image:radial-gradient(rgba(23,27,32,.12) .5px, transparent .5px);
      background-size:7px 7px;
      mask-image:linear-gradient(to bottom,rgba(0,0,0,.5),transparent 75%);
      z-index:99;
    }

    h1,h2,h3,p{margin-top:0}
    h1,h2,h3{
      font-family:'Bodoni Moda',serif;
      font-weight:500;
      letter-spacing:-.035em;
    }
    a{color:inherit}
    img{max-width:100%;display:block}
    .container{width:var(--container);margin-inline:auto}
    .mono{
      font-family:'IBM Plex Mono',monospace;
      letter-spacing:.06em;
      text-transform:uppercase;
    }

    .site-header{
      position:sticky;
      top:0;
      z-index:90;
      backdrop-filter:blur(16px);
      background:rgba(244,239,229,.82);
      border-bottom:1px solid rgba(214,204,186,.75);
    }
    .nav{
      min-height:76px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:24px;
    }
    .logo{
      font:600 27px/1 'Bodoni Moda',serif;
      text-decoration:none;
      letter-spacing:-.04em;
    }
    .logo span{color:var(--copper)}
    .nav-links{display:flex;align-items:center;gap:28px}
    .nav-links a{
      text-decoration:none;
      font-size:14px;
      font-weight:500;
      color:var(--ink-2);
    }
    .nav-cta{
      padding:11px 18px;
      border-radius:999px;
      background:var(--ink);
      color:var(--white)!important;
    }

    .hero{
      position:relative;
      padding:82px 0 96px;
      overflow:hidden;
    }
    .hero::after{
      content:"";
      position:absolute;
      width:520px;
      height:520px;
      border-radius:50%;
      background:var(--paper-2);
      right:-150px;
      top:-170px;
      z-index:-2;
    }
    .hero-grid{
      display:grid;
      grid-template-columns:minmax(0,1.12fr) minmax(380px,.88fr);
      align-items:center;
      gap:72px;
    }
    .eyebrow{
      display:flex;
      align-items:center;
      gap:14px;
      color:var(--terracotta);
      font-size:12px;
      margin-bottom:26px;
    }
    .eyebrow::before{
      content:"";
      width:40px;
      height:2px;
      background:currentColor;
    }
    .hero h1{
      max-width:820px;
      font-size:clamp(48px,6vw,82px);
      line-height:.98;
      margin-bottom:28px;
    }
    .hero h1 em{
      color:var(--copper);
      font-style:italic;
    }
    .hero-lead{
      font-family:'Bodoni Moda',serif;
      font-size:clamp(21px,2vw,29px);
      line-height:1.35;
      max-width:760px;
      margin-bottom:20px;
    }
    .hero-copy{
      max-width:690px;
      color:var(--ink-2);
      font-size:18px;
      line-height:1.75;
    }
    .actions{
      display:flex;
      gap:14px;
      flex-wrap:wrap;
      margin-top:34px;
    }
    .btn{
      min-height:54px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      padding:14px 22px;
      border-radius:12px;
      text-decoration:none;
      font-weight:600;
      border:1px solid transparent;
      transition:transform .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .btn:hover{transform:translateY(-2px)}
    .btn-primary{
      background:var(--ink);
      color:var(--white);
      box-shadow:0 12px 30px rgba(23,27,32,.18);
    }
    .btn-primary:hover{box-shadow:0 16px 36px rgba(23,27,32,.25)}
    .btn-secondary{
      border-color:var(--line);
      background:rgba(255,253,248,.35);
    }

    .journey-panel{
      background:var(--ink);
      color:var(--white);
      border-radius:30px;
      padding:30px;
      box-shadow:var(--shadow);
      position:relative;
      min-height:520px;
    }
    .panel-kicker{color:var(--copper);font-size:11px}
    .journey-panel h2{
      font-size:38px;
      line-height:1.08;
      margin:18px 0 30px;
      color:var(--white);
    }
    .journey-track{
      position:relative;
      padding-left:34px;
      display:grid;
      gap:16px;
    }
    .journey-track::before{
      content:"";
      position:absolute;
      left:8px;
      top:12px;
      bottom:12px;
      width:2px;
      background:linear-gradient(var(--copper),var(--terracotta),var(--sage));
    }
    .journey-step{
      position:relative;
      padding:16px 16px 16px 18px;
      background:#20262C;
      border:1px solid rgba(255,255,255,.08);
      border-radius:16px;
    }
    .journey-step::before{
      content:"";
      position:absolute;
      left:-32px;
      top:24px;
      width:14px;
      height:14px;
      border-radius:50%;
      background:var(--copper);
      box-shadow:0 0 0 5px rgba(201,134,45,.13);
    }
    .journey-step.risk::before{background:var(--terracotta)}
    .journey-step.success::before{background:var(--sage)}
    .journey-step strong{display:block;font-size:15px;margin-bottom:4px}
    .journey-step span{display:block;color:#C7CCD2;font-size:13px}
    .panel-metrics{
      margin-top:20px;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
    }
    .metric{
      background:var(--white);
      color:var(--ink);
      padding:16px;
      border-radius:14px;
    }
    .metric small{display:block;color:var(--terracotta);font:500 10px 'IBM Plex Mono',monospace;text-transform:uppercase}
    .metric strong{display:block;font-size:18px;margin-top:5px}

    .signal-strip{
      background:var(--paper-2);
      border-block:1px solid var(--line);
      padding:20px 0;
    }
    .signal-grid{
      display:grid;
      grid-template-columns:repeat(5,1fr);
      gap:12px;
    }
    .signal{
      display:flex;
      align-items:center;
      gap:10px;
      color:var(--ink-2);
      font-size:13px;
      font-weight:600;
    }
    .signal i{
      width:9px;height:9px;border-radius:50%;background:var(--copper);flex:0 0 auto;
    }

    section{padding:104px 0}
    .section-head{max-width:850px;margin-bottom:54px}
    .section-kicker{color:var(--terracotta);font-size:12px;margin-bottom:14px}
    .section-head h2{
      font-size:clamp(38px,5vw,62px);
      line-height:1.05;
      margin-bottom:18px;
    }
    .section-head p{
      color:var(--ink-2);
      font-size:18px;
      max-width:760px;
    }

    .journey-map{
      background:var(--white);
      border:1px solid var(--line);
      border-radius:28px;
      padding:40px;
      box-shadow:var(--shadow);
    }
    .map-line{
      height:3px;
      margin:72px 40px 0;
      background:linear-gradient(90deg,var(--copper),var(--terracotta),var(--sage));
      position:relative;
    }
    .map-grid{
      display:grid;
      grid-template-columns:repeat(6,1fr);
      gap:18px;
      margin-top:-16px;
    }
    .map-item{text-align:center}
    .map-dot{
      width:30px;height:30px;border-radius:50%;margin:0 auto 22px;background:var(--ink);
      border:8px solid var(--white);
      box-shadow:0 0 0 2px var(--line);
    }
    .map-item:nth-child(1) .map-dot,
    .map-item:nth-child(2) .map-dot{background:var(--copper)}
    .map-item:nth-child(3) .map-dot,
    .map-item:nth-child(4) .map-dot{background:var(--terracotta)}
    .map-item:nth-child(5) .map-dot,
    .map-item:nth-child(6) .map-dot{background:var(--sage)}
    .map-item h3{
      font-family:'Manrope',sans-serif;
      font-size:15px;
      letter-spacing:-.01em;
      margin-bottom:9px;
    }
    .map-item p{font-size:13px;color:var(--ink-2);line-height:1.5}

    .split{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:72px;
      align-items:start;
    }
    .thesis{
      background:var(--ink);
      color:var(--white);
    }
    .thesis .section-kicker{color:var(--copper)}
    .thesis h2{color:var(--white)}
    .thesis p{color:#D5D9DE;font-size:18px}
    .thesis-card{
      position:sticky;
      top:120px;
      background:#20262C;
      border:1px solid rgba(255,255,255,.09);
      border-radius:26px;
      padding:34px;
    }
    .thesis-card blockquote{
      margin:0;
      font:400 30px/1.35 'Fraunces',serif;
    }
    .thesis-card .accent-line{
      width:72px;height:3px;background:var(--copper);margin-bottom:24px;
    }

    .problem-grid{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:18px;
    }
    .problem{
      background:var(--white);
      border:1px solid var(--line);
      border-radius:18px;
      padding:24px;
      min-height:150px;
      transition:transform .2s ease, box-shadow .2s ease;
    }
    .problem:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
    .problem span{
      display:inline-flex;
      width:30px;height:30px;border-radius:50%;
      align-items:center;justify-content:center;
      background:rgba(154,78,61,.10);
      color:var(--terracotta);
      font:500 12px 'IBM Plex Mono',monospace;
      margin-bottom:16px;
    }
    .problem p{margin:0;font-weight:500;line-height:1.5}

    .outcomes{background:var(--paper-2)}
    .outcome-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
    }
    .outcome{
      padding:32px;
      background:var(--white);
      border:1px solid var(--line);
      border-radius:22px;
    }
    .outcome:nth-child(2){background:var(--ink);color:var(--white)}
    .outcome .num{color:var(--copper);font-size:12px;margin-bottom:42px}
    .outcome h3{font-size:29px;line-height:1.08;margin-bottom:16px}
    .outcome p{color:var(--ink-2)}
    .outcome:nth-child(2) p{color:#D7DBDF}

    .products{background:var(--ink);color:var(--white)}
    .products h2{color:var(--white)}
    .products .section-head p{color:#CDD2D8}
    .product-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:22px;
    }
    .product{
      display:flex;
      flex-direction:column;
      min-height:520px;
      padding:34px;
      border-radius:26px;
      background:#20262C;
      border:1px solid rgba(255,255,255,.10);
    }
    .product.featured{
      background:var(--white);
      color:var(--ink);
    }
    .price{
      color:var(--copper);
      font:500 12px 'IBM Plex Mono',monospace;
      text-transform:uppercase;
      letter-spacing:.08em;
    }
    .product h3{
      font-size:38px;
      line-height:1.06;
      margin:22px 0;
    }
    .product p{color:#CFD4D8;font-size:17px}
    .product.featured p{color:var(--ink-2)}
    .product-list{
      margin:10px 0 28px;
      padding:0;
      list-style:none;
      display:grid;
      gap:10px;
    }
    .product-list li{
      display:flex;
      gap:10px;
      font-size:14px;
    }
    .product-list li::before{content:"→";color:var(--copper)}
    .product .btn{margin-top:auto}
    .product.featured .btn{background:var(--ink);color:var(--white)}
    .product:not(.featured) .btn{background:var(--copper);color:var(--ink)}

    .proof-card{
      display:grid;
      grid-template-columns:.72fr 1.28fr;
      gap:42px;
      padding:44px;
      background:var(--white);
      border:1px solid var(--line);
      border-radius:28px;
    }
    .proof-mark{
      min-height:260px;
      border-radius:22px;
      background:var(--mist);
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
      overflow:hidden;
    }
    .proof-mark::before,
    .proof-mark::after{
      content:"";
      position:absolute;
      border:2px solid var(--sage);
      border-radius:50%;
    }
    .proof-mark::before{width:180px;height:180px}
    .proof-mark::after{width:100px;height:100px}
    .proof-mark span{
      width:18px;height:18px;border-radius:50%;
      background:var(--copper);
      z-index:1;
      box-shadow:0 0 0 16px rgba(201,134,45,.18);
    }
    .proof-copy h2{font-size:46px;line-height:1.08}
    .proof-copy p{font-size:18px;color:var(--ink-2)}

    .final-cta{
      padding:110px 0;
      background:var(--paper-2);
      text-align:center;
    }
    .final-cta h2{
      max-width:900px;
      margin:0 auto 20px;
      font-size:clamp(42px,6vw,72px);
      line-height:1;
    }
    .final-cta p{
      max-width:700px;
      margin:0 auto;
      color:var(--ink-2);
      font-size:18px;
    }
    .final-cta .actions{justify-content:center}

    footer{
      background:var(--ink);
      color:#C7CCD1;
      padding:34px 0;
    }
    .footer-row{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:20px;
      font-size:12px;
    }

    .reveal{
      opacity:0;
      transform:translateY(24px);
      transition:opacity .65s ease, transform .65s ease;
    }
    .reveal.visible{opacity:1;transform:none}


    .whatsapp-float{
      position:fixed;
      right:22px;
      bottom:22px;
      z-index:120;
      width:60px;
      height:60px;
      border-radius:50%;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      background:#25D366;
      box-shadow:0 14px 34px rgba(18,140,72,.32);
      text-decoration:none;
      transition:transform .2s ease, box-shadow .2s ease;
    }
    .whatsapp-float:hover{
      transform:translateY(-3px) scale(1.03);
      box-shadow:0 18px 40px rgba(18,140,72,.42);
    }
    .whatsapp-float::before{
      content:"";
      position:absolute;
      inset:-6px;
      border:1px solid rgba(37,211,102,.38);
      border-radius:50%;
      animation:whatsapp-pulse 2.4s ease-out infinite;
    }
    .whatsapp-float svg{
      width:30px;
      height:30px;
      fill:currentColor;
      position:relative;
      z-index:1;
    }
    .whatsapp-label{
      position:absolute;
      right:72px;
      white-space:nowrap;
      padding:9px 12px;
      border-radius:10px;
      background:var(--ink);
      color:var(--white);
      font-size:12px;
      font-weight:600;
      opacity:0;
      transform:translateX(8px);
      pointer-events:none;
      transition:opacity .2s ease, transform .2s ease;
      box-shadow:0 10px 24px rgba(23,27,32,.18);
    }
    .whatsapp-float:hover .whatsapp-label,
    .whatsapp-float:focus-visible .whatsapp-label{
      opacity:1;
      transform:none;
    }
    @keyframes whatsapp-pulse{
      0%{transform:scale(.88);opacity:.75}
      75%,100%{transform:scale(1.22);opacity:0}
    }


    /* =========================================================
       HEADER + HERO EDITORIAL AURORA
       A referência visual é aplicada apenas na primeira dobra.
       ========================================================= */
    .site-header{
      position:absolute;
      inset:0 0 auto;
      z-index:90;
      background:transparent;
      border-bottom:1px solid rgba(255,255,255,.12);
      backdrop-filter:none;
    }
    .site-header .logo,
    .site-header .nav-links a{
      color:#fffafd;
    }
    .site-header .logo span{color:#d6b5e8}
    .site-header .nav-cta{
      background:rgba(255,255,255,.07);
      border:1px solid rgba(255,255,255,.26);
      color:#fffafd!important;
      backdrop-filter:blur(12px);
    }

    .hero{
      min-height:940px;
      display:flex;
      align-items:center;
      padding:145px 0 150px;
      color:#fffafd;
      background:
        radial-gradient(circle at 18% 8%,rgba(190,139,216,.24),transparent 30%),
        radial-gradient(circle at 88% 14%,rgba(225,181,224,.17),transparent 25%),
        #0b1430;
      isolation:isolate;
    }
    .hero::before,
    .hero::after{
      content:"";
      position:absolute;
      pointer-events:none;
      z-index:-1;
      width:48vw;
      height:1150px;
      top:-180px;
      border-radius:50%;
      filter:blur(18px);
      opacity:.6;
    }
    .hero::before{
      left:-13vw;
      background:linear-gradient(
        180deg,
        transparent,
        rgba(196,143,219,.88) 34%,
        rgba(100,82,166,.18) 73%,
        transparent
      );
      transform:rotate(18deg);
    }
    .hero::after{
      right:-16vw;
      background:linear-gradient(
        180deg,
        transparent,
        rgba(231,187,224,.67) 36%,
