      backdrop-filter:blur(16px);
    }
    .journey-track::before{display:none}
    .journey-step{
      min-height:105px;
      padding:15px;
      border-radius:16px;
      background:rgba(11,20,48,.66);
    }
    .journey-step::before{
      position:static;
      display:block;
      width:8px;
      height:8px;
      margin-bottom:10px;
      box-shadow:none;
