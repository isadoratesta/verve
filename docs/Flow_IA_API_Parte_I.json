        "query": "INSERT INTO clientes (nome_negocio, instancia_evolution, plano, status, prompt, whatsapp_contato, email, data_vencimento, criado_em)\nVALUES ($1, $2, $3, $4, $5, $6, $7, $8, NOW())\nRETURNING *;",
