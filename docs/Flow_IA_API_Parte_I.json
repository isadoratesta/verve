    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  c.id,\n  c.nome_negocio,\n  c.instancia_evolution,\n  c.plano,\n  c.status,\n  c.data_vencimento,\n  c.whatsapp_contato,\n  c.email,\n  c.prompt,\n  c.anotacoes,\n  c.origem,\n  c.checklist,\n  c.pagamento,\n  c.criado_em,\n  COUNT(m.id) as mensagens_mes,\n  COALESCE(\n    json_agg(\n      json_build_object(\n        'id', p.id,\n        'valor', p.valor,\n        'status', p.status,\n        'data', p.data_pagamento\n      ) ORDER BY p.data_pagamento DESC\n    ) FILTER (WHERE p.id IS NOT NULL),\n    '[]'\n  ) as pagamentos\nFROM clientes c\nLEFT JOIN mensagens m ON m.cliente_id = c.id\n  AND m.criado_em >= date_trunc('month', NOW())\nLEFT JOIN pagamentos p ON p.cliente_id = c.id\nGROUP BY c.id\nORDER BY c.criado_em DESC",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        208,
        0
      ],
      "id": "5be72dbe-b930-46c6-b57e-64134557c21d",
